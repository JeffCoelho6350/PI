<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PI.ViewModels"
             x:Class="PI.Views.CredentialDetailPage"
             x:DataType="vm:CredentialDetailViewModel"
             Title="{Binding PageTitle}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Título / Serviço -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Título / Serviço *"
                       FontSize="14"
                       FontAttributes="Bold" />
                <Entry Text="{Binding Title}"
                       Placeholder="Ex: Google, GitHub, Banco"
                       ClearButtonVisibility="WhileEditing" />
            </VerticalStackLayout>

            <!-- Usuário / E-mail -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Usuário ou E-mail"
                       FontSize="14"
                       FontAttributes="Bold" />
                <Entry Text="{Binding Username}"
                       Placeholder="Ex: seuemail@exemplo.com"
                       ClearButtonVisibility="WhileEditing"
                       Keyboard="Email" />
            </VerticalStackLayout>

            <!-- Senha -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Senha"
                       FontSize="14"
                       FontAttributes="Bold" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry Grid.Column="0"
                           Text="{Binding Password}"
                           Placeholder="Digite a senha"
                           IsPassword="{Binding IsPasswordHidden}"
                           ClearButtonVisibility="WhileEditing" />
                    <Button Grid.Column="1"
                            Text="{Binding IsPasswordHidden, Converter={x:Null}}"
                            WidthRequest="80"
                            FontSize="12"
                            BackgroundColor="{StaticResource Gray100}"
                            TextColor="{StaticResource Gray900}"
                            Command="{Binding TogglePasswordVisibilityCommand}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsPasswordHidden}" Value="True">
                                <Setter Property="Text" Value="Mostrar" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding IsPasswordHidden}" Value="False">
                                <Setter Property="Text" Value="Ocultar" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
            </VerticalStackLayout>

            <!-- Observações -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Observações"
                       FontSize="14"
                       FontAttributes="Bold" />
                <Editor Text="{Binding Notes}"
                        Placeholder="Anotações adicionais, dicas de recuperação..."
                        HeightRequest="100"
                        AutoSize="Disabled" />
            </VerticalStackLayout>

            <!-- Botões de Ação -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,20,0,0">
                <Button Grid.Column="0"
                        Text="Cancelar"
                        HeightRequest="50"
                        CornerRadius="8"
                        BackgroundColor="{StaticResource Gray200}"
                        TextColor="{StaticResource Gray900}"
                        Command="{Binding CancelCommand}" />

                <Button Grid.Column="1"
                        Text="Salvar"
                        HeightRequest="50"
                        CornerRadius="8"
                        FontAttributes="Bold"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="{StaticResource White}"
                        Command="{Binding SaveCommand}" />
            </Grid>

            <!-- Indicador de carregamento -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
