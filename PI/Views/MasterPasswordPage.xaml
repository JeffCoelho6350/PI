<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PI.ViewModels"
             x:Class="PI.Views.MasterPasswordPage"
             x:DataType="vm:MasterPasswordViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             Title="{Binding PageTitle}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20" VerticalOptions="Center">

            <!-- Cabeçalho -->
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center" Margin="0,20,0,10">
                <Label Text="🔐"
                       FontSize="48"
                       HorizontalOptions="Center" />
                <Label Text="{Binding PageTitle}"
                       FontSize="26"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />
                <Label Text="{Binding Subtitle}"
                       FontSize="14"
                       TextColor="{StaticResource Gray500}"
                       HorizontalTextAlignment="Center"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Campo Senha -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Senha-Mestra"
                       FontSize="14"
                       FontAttributes="Bold" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry Grid.Column="0"
                           Text="{Binding Password}"
                           Placeholder="Digite sua senha-mestra"
                           IsPassword="{Binding IsPasswordHidden}"
                           ClearButtonVisibility="WhileEditing" />
                    <Button Grid.Column="1"
                            Text="{Binding IsPasswordHidden, Converter={x:Null}}"
                            WidthRequest="80"
                            FontSize="12"
                            BackgroundColor="{StaticResource Gray100}"
                            TextColor="{StaticResource Gray900}"
                            Command="{Binding TogglePasswordVisibilityCommand}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsPasswordHidden}" Value="True">
                                <Setter Property="Text" Value="Mostrar" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding IsPasswordHidden}" Value="False">
                                <Setter Property="Text" Value="Ocultar" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
            </VerticalStackLayout>

            <!-- Campo Confirmar Senha (apenas no primeiro setup) -->
            <VerticalStackLayout Spacing="6" IsVisible="{Binding IsFirstSetup}">
                <Label Text="Confirmar Senha-Mestra"
                       FontSize="14"
                       FontAttributes="Bold" />
                <Entry Text="{Binding ConfirmPassword}"
                       Placeholder="Repita a senha-mestra"
                       IsPassword="{Binding IsPasswordHidden}"
                       ClearButtonVisibility="WhileEditing" />
            </VerticalStackLayout>

            <!-- Botão de Ação -->
            <Button Text="{Binding ButtonText}"
                    FontAttributes="Bold"
                    FontSize="16"
                    HeightRequest="50"
                    CornerRadius="8"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="{StaticResource White}"
                    Command="{Binding SubmitCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Margin="0,10,0,0" />

            <!-- Indicador de progresso (derivação de chave PBKDF2) -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}"
                               HorizontalOptions="Center" />

            <Label Text="Processando criptografia segura..."
                   FontSize="12"
                   TextColor="{StaticResource Gray400}"
                   HorizontalOptions="Center"
                   IsVisible="{Binding IsBusy}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
