<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PI.ViewModels"
             xmlns:models="clr-namespace:PI.Models"
             x:Class="PI.Views.CredentialListPage"
             x:DataType="vm:CredentialListViewModel"
             Shell.TabBarIsVisible="False"
             Title="Cofre Digital">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16">

        <!-- Barra Superior / Resumo -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12" VerticalOptions="Center">
            <Label Grid.Column="0"
                   Text="Minhas Credenciais"
                   FontSize="22"
                   FontAttributes="Bold"
                   VerticalOptions="Center" />
            <Button Grid.Column="1"
                    Text="Bloquear"
                    FontSize="12"
                    HeightRequest="36"
                    Padding="12,0"
                    BackgroundColor="{StaticResource Gray100}"
                    TextColor="{StaticResource Gray900}"
                    Command="{Binding LockVaultCommand}" />
        </Grid>

        <!-- Lista de Credenciais -->
        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding LoadCredentialsCommand}">
            <Grid>
                <!-- Mensagem quando vazio -->
                <VerticalStackLayout IsVisible="{Binding IsEmpty}"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="12">
                    <Label Text="Nenhuma credencial cadastrada."
                           FontSize="16"
                           TextColor="{StaticResource Gray500}"
                           HorizontalOptions="Center" />
                    <Label Text="Toque no botão abaixo para adicionar a primeira."
                           FontSize="14"
                           TextColor="{StaticResource Gray400}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- CollectionView com as credenciais -->
                <CollectionView ItemsSource="{Binding Credentials}"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Credential">
                            <Border StrokeShape="RoundRectangle 8"
                                    Stroke="{StaticResource Gray200}"
                                    BackgroundColor="{AppThemeBinding Light=White, Dark=#2B2B2B}"
                                    Padding="12"
                                    Margin="0,0,0,10">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                    <!-- Informações -->
                                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                                        <Label Text="{Binding Title}"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Username}"
                                               FontSize="14"
                                               TextColor="{StaticResource Gray500}"
                                               LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>

                                    <!-- Botão Editar -->
                                    <Button Grid.Column="1"
                                            Text="Editar"
                                            FontSize="12"
                                            Padding="10,4"
                                            HeightRequest="36"
                                            BackgroundColor="{StaticResource Secondary}"
                                            TextColor="{StaticResource Tertiary}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CredentialListViewModel}}, Path=EditCredentialCommand}"
                                            CommandParameter="{Binding .}" />

                                    <!-- Botão Excluir -->
                                    <Button Grid.Column="2"
                                            Text="Excluir"
                                            FontSize="12"
                                            Padding="10,4"
                                            HeightRequest="36"
                                            BackgroundColor="#FCE4EC"
                                            TextColor="#C2185B"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CredentialListViewModel}}, Path=DeleteCredentialCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </RefreshView>

        <!-- Botão Adicionar Credencial -->
        <Button Grid.Row="2"
                Text="+ Nova Credencial"
                FontAttributes="Bold"
                FontSize="16"
                HeightRequest="50"
                CornerRadius="8"
                BackgroundColor="{StaticResource Primary}"
                TextColor="{StaticResource White}"
                Command="{Binding AddNewCredentialCommand}"
                Margin="0,12,0,0" />

    </Grid>

</ContentPage>
